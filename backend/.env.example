# ===== 应用配置 =====
NODE_ENV=development
PORT=3000
APP_NAME=football-dazi

# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=football_dazi
DB_USER=root
DB_PASSWORD=your_password
DB_POOL_MAX=10
DB_POOL_MIN=2

# ===== JWT 配置 =====
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ===== 微信小程序配置 =====
WX_APPID=wx1234567890abcdef
WX_SECRET=your_wx_secret
WX_MCHID=1900000109
WX_PAY_KEY=your_32_chars_api_key_for_md5_sign
WX_NOTIFY_URL=https://api.footballdazi.com/api/payment/notify

# ===== 微信支付证书路径 =====
WX_CERT_PATH=./certs/apiclient_cert.pem
WX_KEY_PATH=./certs/apiclient_key.pem

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 日志 =====
LOG_LEVEL=info
LOG_PATH=./logs

# ===== CORS =====
CORS_ORIGIN=*