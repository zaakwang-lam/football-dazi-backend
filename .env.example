# ============================================
# 足球搭子 - 云端统一环境变量
# 复制此文件为 .env，填入真实值（.env 不要提交 Git）
# 修改后执行：docker compose up -d --force-recreate backend
# ============================================

# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=Football@2026
MYSQL_PASSWORD=Football@2026

# ========== JWT ==========
JWT_SECRET=please-change-this-to-random-32-char-string
JWT_EXPIRES_IN=30d

# ========== 微信小程序 ==========
WX_APPID=wxb0faf2bff3330fc1
WX_SECRET=your-wechat-secret-here

# ========== 微信支付 ==========
WX_MCHID=your-merchant-id
WX_PAY_KEY=your-32-char-pay-key
# 灰度期用服务器 IP，正式上线用域名
WX_NOTIFY_URL=https://footballdazi.cn/api/payment/notify
WX_TEMPLATE_ID_BOOK=

# ========== 静态资源公网前缀（头像/球场图） ==========
PUBLIC_BASE_URL=https://footballdazi.cn

# ========== 审核测试登录（过审后务必改为 0） ==========
# 1 = 开启 POST /api/v1/auth/test-login；0 = 关闭
TEST_LOGIN_ENABLED=0
TEST_LOGIN_SECRET=football-audit-2026
